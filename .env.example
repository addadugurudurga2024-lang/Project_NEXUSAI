# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=nexusai

# JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# AI Document Analysis (leave blank to use Demo Analysis Mode)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# App Configuration
BACKEND_PORT=8000
UPLOAD_DIR=../uploads
MAX_UPLOAD_SIZE_MB=25

# Seed configuration (used by scripts/seed_data.py)
SEED_ADMIN_PASSWORD=
